spring:
  application:
    name: LinXR

  # MySQL datasource (Docker)
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3307/linxr?serverTimezone=Asia/Shanghai&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:your_password}

  # Redis (Docker)
  data:
    redis:
      host: localhost
      port: 6379
      # password:  # 如果Redis设置了密码，取消注释并填写
      timeout: 3000ms
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0
          max-wait: -1ms

  # MinIO (Docker)
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

server:
  port: 8080
  servlet:
    encoding:
      charset: UTF-8
      enabled: true
      force: true

# CORS 配置（生产环境请替换为实际域名）
cors:
  allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080}

# MinIO 配置
minio:
  endpoint: http://localhost:9000
  access-key: ${MINIO_USERNAME:minioadmin}
  secret-key: ${MINIO_PASSWORD:your_password}
  bucket: linxr

# MyBatis-Plus
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
  mapper-locations: classpath*:/mapper/*.xml

# LangChain4j
langchain4j:
  open-ai:
    chat-model:
      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
      api-key: ${DASHSCOPE_API_KEY:sk-your-api-key-here}
      model-name: qwen-plus
      log-requests: true
      log-responses: true
    streaming-chat-model:
      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
      api-key: ${DASHSCOPE_API_KEY:sk-your-api-key-here}
      model-name: qwen-plus
      log-requests: true
      log-responses: true

  ollama:
    embedding-model:
      base-url: http://localhost:11434
      model-name: bge-m3
      log-requests: true
      log-responses: true

  # Redis 向量数据库
  community:
    redis:
      host: localhost
      port: 6379

# Logging
logging:
  level:
    com.jjwpp.linxr: INFO
    dev.langchain4j: debug
    root: WARN
